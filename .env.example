# -----------------------------------------------------------------------------
# IndexDesk — Environment Configuration Example (.env.example)
# Copy this file to .env.local for local development.
# -----------------------------------------------------------------------------

# Environment
NODE_ENV=development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=Development

# Web App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
PORT=3000

# PostgreSQL / TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=indexdesk
POSTGRES_USER=indexdesk
POSTGRES_PASSWORD=indexdesk_dev_secret
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=indexdesk;Username=indexdesk;Password=indexdesk_dev_secret;Include Error Detail=true

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=indexdesk_redis_dev
ConnectionStrings__Redis=localhost:6379,password=indexdesk_redis_dev,abortConnect=false

# RabbitMQ Messaging
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=indexdesk
RABBITMQ_PASS=indexdesk_rabbit_dev
ConnectionStrings__RabbitMQ=amqp://indexdesk:indexdesk_rabbit_dev@localhost:5672

# Observability & Distributed Tracing (OpenTelemetry -> Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=IndexDesk.Local
OpenTelemetry__OtlpEndpoint=http://localhost:4317

# Security & Authentication (JWT & Argon2id)
Jwt__Secret=development_super_secret_key_with_at_least_256_bits_for_indexdesk_jwt_signing_token_2026
Jwt__Issuer=IndexDesk.Auth
Jwt__Audience=IndexDesk.Web
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# External Market Data Providers (Ingestion / Background Sync)
# See PROVIDERS.md for limits and details
# Sync Catch-Up Bootstrap (one-shot catch-up on Worker startup)
Sync__CatchUp__Enabled=true
Sync__CatchUp__MaxBacklogDays=30
Sync__CatchUp__LockTimeoutSeconds=30

Providers__Bcb__BaseUrl=https://api.bcb.gov.br/dados/serie/bcdata.sgs
Providers__Cvm__BaseUrl=https://dados.cvm.gov.br/dados/CIA_ABERTA/DOC/IPE/DADOS
Providers__Anbima__BaseUrl=https://www.anbima.com.br

# OHLCV chain (Worker only): Brapi (1) -> Yahoo sidecar (2) -> TradingView sidecar (3)
# Brapi free plan is anonymous-whitelist-only (401 MISSING_TOKEN outside it); token required.
# Array entries multiply rpm through the key pool (token bucket 10 req/min/key).
Providers__Brapi__ApiKeys__0=
Providers__Brapi__BaseUrl=https://brapi.dev/api

# Yahoo chrome-sim: se der 401 crumb / _SUPERFLY_lockout_finance=1, exporte Cookie de
#  finance.yahoo.com/chart/{TICKER}.SA (A1/A3/A1S) — yfinance curl_cffi chrome já cobre 99% sem isso
Providers__Yahoo__Cookie=
Providers__Yahoo__BaseUrl=https://query1.finance.yahoo.com

# Python sidecar (tools/providers/sidecar, uv) — used by the Yahoo/TradingView/InfoMoney
# clients and by the `fetch` transport for WAF'd hosts. Empty values use code defaults.
Providers__Sidecar__UvPath=
Providers__Sidecar__ProjectPath=
Providers__Sidecar__TimeoutSeconds=120

# TradingView auth = authenticated session COOKIE (tv-scraper has no email/password flow).
# Secret: never commit/log; an export without sessionid/JWT does not authenticate.
Providers__TradingView__Cookie=

# FX daily sync (AwesomeAPI) — USD-BRL,EUR-BRL,BTC-BRL bid/ask into fx_rates
Providers__AwesomeApi__BaseUrl=https://economia.awesomeapi.com.br/
# Premium token sk_... (optional); array form Providers__AwesomeApi__Tokens__0..N also binds.
Providers__AwesomeApi__Token=

# InfoMoney secondary source — OUTSIDE the OHLCV chain (backfill --provider infomoney only).
# Azure APIM subscription key(s); injected into the sidecar child process env.
Providers__InfoMoney__SubscriptionKeys__0=

# MSB cookies rotativos (não-commit):
# MSN GOLD11 (assets.msn.com/service/Finance): warm-up em msn.com p/ MUID/_EDGE_S/_EDGE_V
# + bundle apikey (ex. 0Q4oD8h8CC...). Probe 26-08 deu 401 App auth not found — guardar em
# Providers__Msn__Cookie e usar via sidecar Session(impersonate="chrome")).
# MaisRetorno data.maisretorno.com (gated PRO): Cookie __Secure-next-auth.session-token
# -> GET /api/auth/session -> accessToken aud mrdata -> Bearer; mesmo com Bearer, free
# deu 403 (sem role PRO) — não bypass. Manter cookie só se virar PRO; ver §2.15/2.19.
Providers__Msn__Cookie=
# Opcoes.net.br: sem cookie/key (só z=seg/10 como bust) — público

# ETF holdings weekly sync — It Now rides the sidecar fetch transport by default (Akamai TLS
# fingerprinting blocks native HttpClient). FundCodes fallback map is seeded in the Worker
# appsettings.json (BOVV11=BRBOVVCTF009).
Providers__Holdings__ItNow__Transport=sidecar
