{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indexdesk.local/schemas/roadmap.json",
  "title": "IndexDesk Roadmap",
  "description": "Schema for the source-controlled IndexDesk implementation roadmap.",
  "type": "object",
  "required": ["document_type"],
  "properties": {
    "$schema": { "type": "string" },
    "document_type": { "enum": ["roadmap", "phase", "decisions", "risks"] },
    "schema_version": { "type": "string" },
    "project": { "$ref": "#/$defs/project" },
    "source_documents": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
    "current_state": { "$ref": "#/$defs/currentState" },
    "phase_order": { "type": "array", "items": { "type": "string", "pattern": "^PHASE-[0-9]{2}$" } },
    "updated_at": { "type": "string", "format": "date" },
    "phase": { "$ref": "#/$defs/phase" },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } }
  },
  "allOf": [
    {
      "if": { "properties": { "document_type": { "const": "roadmap" } } },
      "then": { "required": ["schema_version", "project", "source_documents", "current_state", "phase_order", "updated_at"] }
    },
    {
      "if": { "properties": { "document_type": { "const": "phase" } } },
      "then": { "required": ["schema_version", "phase"] }
    },
    {
      "if": { "properties": { "document_type": { "const": "decisions" } } },
      "then": { "required": ["schema_version", "decisions"] }
    },
    {
      "if": { "properties": { "document_type": { "const": "risks" } } },
      "then": { "required": ["schema_version", "risks"] }
    }
  ],
  "$defs": {
    "status": { "enum": ["not_started", "in_progress", "blocked", "complete", "deferred", "out_of_scope"] },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "difficulty": { "enum": ["trivial", "easy", "medium", "hard", "complex"] },
    "kind": { "enum": ["feature", "infrastructure", "architecture", "data", "database", "backend", "frontend", "analytics", "admin", "security", "seo", "content", "operations", "research", "decision"] },
    "sourceRef": {
      "type": "object",
      "required": ["file", "section"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "lines": { "type": "string" }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "currentState": {
      "type": "object",
      "required": ["lifecycle", "implementation_status", "roadmap_tracking_scaffolded", "code_scaffolded", "git_commits", "completed_task_ids", "blockers", "notes"],
      "properties": {
        "lifecycle": { "enum": ["greenfield", "active_development", "maintenance"] },
        "implementation_status": { "enum": ["documentation_only", "scaffolded", "mvp", "production"] },
        "roadmap_tracking_scaffolded": { "type": "boolean" },
        "code_scaffolded": { "type": "boolean" },
        "git_commits": { "type": "integer", "minimum": 0 },
        "completed_task_ids": { "type": "array", "items": { "type": "string" } },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "description", "status", "priority", "difficulty", "kind", "phase_id", "epic_id", "depends_on", "blocks", "source_refs", "acceptance_criteria", "deliverables", "risks", "notes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "priority": { "$ref": "#/$defs/priority" },
        "difficulty": { "$ref": "#/$defs/difficulty" },
        "kind": { "$ref": "#/$defs/kind" },
        "phase_id": { "type": "string", "pattern": "^PHASE-[0-9]{2}$" },
        "epic_id": { "type": "string", "pattern": "^[A-Z0-9]+$" },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "blocks": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" }, "minItems": 1 },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "deliverables": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "risks": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "estimated_hours": { "type": "number", "exclusiveMinimum": 0 },
        "assignee": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"], "format": "date" }
      },
      "additionalProperties": false
    },
    "epic": {
      "type": "object",
      "required": ["id", "name", "description", "status", "priority", "depends_on", "source_refs", "acceptance_criteria", "tasks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9]+$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "priority": { "$ref": "#/$defs/priority" },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" }, "minItems": 1 },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "required": ["id", "order", "name", "objective", "status", "priority", "depends_on", "source_refs", "epics"],
      "properties": {
        "id": { "type": "string", "pattern": "^PHASE-[0-9]{2}$" },
        "order": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "objective": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "priority": { "$ref": "#/$defs/priority" },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" }, "minItems": 1 },
        "epics": { "type": "array", "items": { "$ref": "#/$defs/epic" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["id", "title", "status", "priority", "context", "options", "recommendation", "impact", "source_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^DEC-[0-9]{3}$" },
        "title": { "type": "string" },
        "status": { "enum": ["open", "accepted", "rejected", "superseded"] },
        "priority": { "$ref": "#/$defs/priority" },
        "context": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "recommendation": { "type": "string" },
        "impact": { "type": "string" },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" }, "minItems": 1 },
        "decided_at": { "type": ["string", "null"], "format": "date" }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["id", "title", "status", "probability", "impact", "description", "mitigation", "owner", "source_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^RISK-[0-9]{3}$" },
        "title": { "type": "string" },
        "status": { "enum": ["open", "mitigated", "accepted", "closed"] },
        "probability": { "enum": ["low", "medium", "high"] },
        "impact": { "enum": ["low", "medium", "high", "critical"] },
        "description": { "type": "string" },
        "mitigation": { "type": "string" },
        "owner": { "type": "string" },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" }, "minItems": 1 }
      },
      "additionalProperties": false
    }
  }
}
